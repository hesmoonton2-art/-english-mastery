{
  "name": "english-mastery",
  "version": "1.0.0",
  "private": true,
  "description": "English Mastery \u2014 Basic to Advanced: a self-contained Myanmar-language English learning platform.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:apk": "CAPACITOR_BUILD=1 next build && cap sync android && cd android && ./gradlew assembleDebug",
    "cap:sync": "CAPACITOR_BUILD=1 next build && cap sync android"
  },
  "dependencies": {
    "next": "15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.7",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2"
  }
}
